# ──────────────────────────────────────────────────────────
# Beaver-Sync Production Configuration
# ──────────────────────────────────────────────────────────
# Copy this file: cp .env.production.example .env
# Only Tier 1 vars are required. Tier 2 enables cloud features.
# All other vars are auto-derived by resolveConfig().

# ── TIER 1: Required ──────────────────────────────────────

# Database
DATABASE_URL=postgresql://beaver:CHANGE_ME@localhost:5432/beaver
POSTGRES_PASSWORD=CHANGE_ME

# Public URL (clients connect here)
APP_URL=https://your-domain.com
# Behind Caddy/NPM/Cloudflare — required for correct req.ip rate-limiting + secure cookies
TRUST_PROXY=true
ALLOWED_ORIGINS=https://your-domain.com

# Secrets (generate with: openssl rand -hex 32)
COOKIE_SECRET=
SESSION_HMAC_KEY=
EMAIL_HMAC_KEY=
NOTE_HMAC_KEY=
# Required in production: the API exits at startup without it.
INTERNAL_API_SECRET=

# Password/email auth. Set it explicitly so the intent is visible: unset is
# treated as enabled by both the API and docker-entrypoint.sh (which generates
# the JWT keys into the beaver_data volume when they are missing).
LEGACY_AUTH_ENABLED=true

# Post-quantum encryption seed (128 hex chars)
# Generate with: openssl rand -hex 64
# THIS IS YOUR MASTER KEY — lose it and encrypted data is unrecoverable
MLKEM_SEED=

# ── TIER 2: Cloud features (optional) ─────────────────────

# Cloudflare R2 storage (enables sync, assets, commits)
# Names must stay STORAGE_*: docker-compose.prod.yml hard-fails without them.
STORAGE_BACKEND=cloudflare-r2
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=beaver-sync
STORAGE_PUBLIC_ENDPOINT=https://pub-YOUR_HASH.r2.dev

# WebAuthn (passkey authentication — required for production)
WEBAUTHN_RPID=your-domain.com
WEBAUTHN_ORIGIN=https://your-domain.com

# Email (transactional — invites, receipts, notifications)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@your-domain.com
# Inbound reply forwarding: without this an attacker can POST forged mail to
# /email/inbound and have it forwarded to any alias holder.
INBOUND_WEBHOOK_SECRET=
NOTIFY_DOMAIN=notify.your-domain.com

# Offsite pg_dump copy (host cron needs `aws` CLI; sidecar skips if absent)
# BACKUP_S3_TARGET=s3://beaver-backups/pg
# BACKUP_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ── TIER 3: Enterprise (only if needed) ───────────────────
# In dev ENTERPRISE_MODE=true alone is enough; in prod a valid offline HMAC license
# is required (BL<base64url(payload)>.<base64url(HMAC)>, payload {licensee, plan:'enterprise', seats?, expiry},
# 14d grace, seats soft-warn). Generate:
#   LICENSE_SECRET=$(openssl rand -hex 32) node scripts/generate-license.js --licensee "Acme" --expiry 2027-08-30 --seats 50
# ENTERPRISE_MODE=true
# LICENSE_SECRET=
# LICENSE_KEY=
# GLITCHTIP_DSN=
