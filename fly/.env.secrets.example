# Beaver-Sync Fly.io Secrets
# Copy to .env.secrets and fill in real values
#   cp fly/.env.secrets.example fly/.env.secrets

# ── Database ──
DATABASE_URL=postgresql://...

# ── API App ──
COOKIE_SECRET=
SESSION_HMAC_KEY=
EMAIL_HMAC_KEY=
NOTE_HMAC_KEY=
MLKEM_SEED=
JWT_PRIVATE_KEY_PATH=/app/keys/jwt.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt.pub
WEBAUTHN_RPID=api.beavernotes.com
WEBAUTHN_ORIGIN=https://api.beavernotes.com
APP_URL=https://api.beavernotes.com
ALLOWED_ORIGINS=https://beavernotes.com,https://api.beavernotes.com

# R2 Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=beaver-sync
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# Monitoring
GLITCHTIP_DSN=http://beaver-glitchtip.internal:8000/0

# ── GlitchTip App ──
GLITCHTIP_SECRET_KEY=

# ── JWT Keys (base64-encoded PEM, written to volume at deploy time) ──
# Generate with:
#   openssl genpkey -algorithm RSA -out jwt.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
#   JWT_PRIVATE_KEY_B64=$(base64 < jwt.pem)
#   JWT_PUBLIC_KEY_B64=$(base64 < jwt.pub)
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
