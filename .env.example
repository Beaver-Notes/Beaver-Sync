# ──────────────────────────────────────────────────────────
# 1. REQUIRED
# ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
COOKIE_SECRET=change-me-cookie-secret
DATABASE_URL=postgresql://beaver:beaver@localhost:5432/beaver
# Host-facing API origin — clients fetch signed asset URLs from here
APP_URL=http://localhost:4000

# ── Postgres (used by docker compose) ─────────────────────────────
POSTGRES_DB=beaver
POSTGRES_USER=beaver
POSTGRES_PASSWORD=beaver

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── API host port (docker compose) ────────────────────────────────
# Host port for the API container (container-internal port stays 3000). Default: 4000.
# API_PORT=4000

# ──────────────────────────────────────────────────────────
# 2. CRYPTO KEYS (each min 32 chars, generate with openssl rand -hex 32)
# ──────────────────────────────────────────────────────────
SESSION_HMAC_KEY=change-me-session-hmac-key-min-32-chars
EMAIL_HMAC_KEY=change-me-email-hmac-key-min-32-chars
NOTE_HMAC_KEY=change-me-note-hmac-key-min-32-chars

# ML-KEM post-quantum encryption seed (64 bytes / 128 hex chars)
#   openssl rand -hex 64
# Generated automatically on first boot if unset.
MLKEM_SEED=
MLKEM_SEED_PATH=./keys/mlkem-seed.hex

# ──────────────────────────────────────────────────────────
# 3. AUTH — Password + Passkey
# ──────────────────────────────────────────────────────────
LEGACY_AUTH_ENABLED=true
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_EXPIRES_IN=30d
SESSION_MAX_AGE_DAYS=30
SESSION_TTL_HOURS=720
IDLE_TIMEOUT_HOURS=24

WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Beaver Sync

# ──────────────────────────────────────────────────────────
# 4. STORAGE — MinIO / S3 / R2
# ──────────────────────────────────────────────────────────
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=beaver-sync
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# S3-compatible aliases (same schema as STORAGE_*)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# R2-specific
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# MinIO-specific
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=beaver-sync
MINIO_ENDPOINT=http://minio:9000

# LAN-accessible IP for MinIO presigned URLs (defaults to localhost)
# Set to your machine's LAN IP for multi-device access, e.g. LAN_IP=192.168.1.42
LAN_IP=localhost

# ──────────────────────────────────────────────────────────
# 5. EMAIL — Transactional + Alias Relay
# ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@beavernotes.com
NOTIFY_DOMAIN=notify.beavernotes.com

# Inbound forwarding: set FORWARD_TYPE=sendmail or configure SMTP
FORWARD_TYPE=
FORWARD_SMTP_HOST=
FORWARD_SMTP_PORT=587
FORWARD_SMTP_USER=
FORWARD_SMTP_PASS=
FORWARD_FROM_ADDRESS=

# ──────────────────────────────────────────────────────────
# 6. PAYMENTS — Stripe
# ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# ──────────────────────────────────────────────────────────
# 7. PAYMENTS — Apple App Store IAP
# ──────────────────────────────────────────────────────────
APPLE_BUNDLE_ID=
# Create a .p8 key in App Store Connect > Users > Keys > In-App Purchase
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_P8_KEY_PATH=./keys/apple.p8

# ──────────────────────────────────────────────────────────
# 8. PAYMENTS — Google Play IAP
# ──────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./keys/google-service-account.json
GOOGLE_PUBSUB_TOPIC=

# ──────────────────────────────────────────────────────────
# 9. ENTERPRISE MODE (self-hosted, bypasses plan checks)
# ──────────────────────────────────────────────────────────
# In development, ENTERPRISE_MODE=true alone unlocks enterprise features.
# In production (NODE_ENV=production), a valid offline HMAC license key is
# required: set LICENSE_KEY to a BL... token and LICENSE_SECRET to the HMAC
# secret it was signed with. Generate with:
#   LICENSE_SECRET=$(openssl rand -hex 32) node scripts/generate-license.js --licensee "Acme" --expiry 2027-08-30 --seats 50
# Licenses are offline-verified (HMAC-SHA256, timing-safe), 14d grace after expiry,
# seats is a soft limit (warn only). Script is excluded from Docker images.
ENTERPRISE_MODE=false
LICENSE_SECRET=
LICENSE_KEY=
# Alternative env names also accepted: BEAVER_LICENSE, LICENSE

# ──────────────────────────────────────────────────────────
# 10. MONITORING
# ──────────────────────────────────────────────────────────
GLITCHTIP_DSN=

# ──────────────────────────────────────────────────────────
# 11. REALTIME COLLABORATION (ws-relay)
# ──────────────────────────────────────────────────────────
AUTH_BACKEND_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────
# 12. TIME-OUTS
# ──────────────────────────────────────────────────────────
CONNECTION_TIMEOUT_MS=0
KEEP_ALIVE_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────
# 13. RATE LIMITS
# ──────────────────────────────────────────────────────────
# All *_RATE_LIMIT_PER_MINUTE vars default to sensible values
# if unset. Below are the commonly tuned ones.

# Global
API_RATE_LIMIT_PER_MINUTE=100
HEALTH_RATE_LIMIT_PER_MINUTE=30

# Auth
AUTH_RATE_LIMIT_PER_MINUTE=5
VERIFY_SESSION_RATE_LIMIT_PER_MINUTE=60
LOGOUT_RATE_LIMIT_PER_MINUTE=20
SESSION_LIST_RATE_LIMIT_PER_MINUTE=30
SESSION_REVOKE_RATE_LIMIT_PER_MINUTE=20
SESSION_REVOKE_ALL_RATE_LIMIT_PER_MINUTE=3

# Account
ACCOUNT_READ_RATE_LIMIT_PER_MINUTE=30
ACCOUNT_DELETE_RATE_LIMIT_PER_MINUTE=3
USERNAME_RATE_LIMIT_PER_MINUTE=10
DEVICE_DELETE_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=3

# Sync (commits, snapshots, assets)
COMMIT_WRITE_RATE_LIMIT_PER_MINUTE=60
COMMIT_READ_RATE_LIMIT_PER_MINUTE=120
COMMIT_OBJECT_READ_RATE_LIMIT_PER_MINUTE=120
COMMIT_HISTORY_RATE_LIMIT_PER_MINUTE=30
SNAPSHOT_WRITE_RATE_LIMIT_PER_MINUTE=30
SNAPSHOT_READ_RATE_LIMIT_PER_MINUTE=60
ASSET_WRITE_RATE_LIMIT_PER_MINUTE=30
ASSET_READ_RATE_LIMIT_PER_MINUTE=120
ASSET_LIST_RATE_LIMIT_PER_MINUTE=60
ASSET_DELETE_RATE_LIMIT_PER_MINUTE=30

# Other
COLLAB_RATE_LIMIT_PER_MINUTE=30
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WORKSPACE_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=20
AUDIT_RATE_LIMIT_PER_MINUTE=20
QUICKCONNECT_GENERATE_RATE_LIMIT_PER_MINUTE=10
QUICKCONNECT_POLL_RATE_LIMIT_PER_MINUTE=30
QUICKCONNECT_APPROVE_RATE_LIMIT_PER_MINUTE=10

# ──────────────────────────────────────────────────────────
# 14. BODY SIZE LIMITS
# ──────────────────────────────────────────────────────────
# All *_BODY_LIMIT_BYTES vars default to sensible values
# if unset. Below are the commonly tuned ones.

API_BODY_LIMIT_BYTES=1048576
AUTH_BODY_LIMIT_BYTES=16384
SESSION_REVOKE_ALL_BODY_LIMIT_BYTES=8192
WEBHOOK_BODY_LIMIT_BYTES=262144
SNAPSHOT_BODY_LIMIT_BYTES=10485760
COMMIT_BODY_LIMIT_BYTES=10485760
ASSET_MAX_SIZE_BYTES=104857600
COLLAB_BODY_LIMIT_BYTES=1048576
WORKSPACE_BODY_LIMIT_BYTES=65536
ADMIN_BODY_LIMIT_BYTES=65536
AUDIT_BODY_LIMIT_BYTES=65536
ACCOUNT_DELETE_BODY_LIMIT_BYTES=16384
QUICKCONNECT_MAX_PAYLOAD_BYTES=8192

# ──────────────────────────────────────────────────────────
# 15. EXPORT, ASSET URL TTL, SYNC TUNING
# ──────────────────────────────────────────────────────────
EXPORT_MAX_OBJECTS=10000
EXPORT_URL_TTL_SECONDS=3600
ASSET_URL_TTL_SECONDS=3600
COMMIT_CURSOR_MAX_ENTRIES=1000
COMMIT_CURSOR_QUERY_MAX_BYTES=65536
MAX_COMPACTED_COMMIT_IDS=500

# ──────────────────────────────────────────────────────────
# 11b. REALTIME — WS RELAY AUTH TICKETS & TUNING
# ──────────────────────────────────────────────────────────
# TTL (seconds) of one-time WebSocket auth tickets issued by /auth/ws-ticket.
WS_TICKET_TTL_SECONDS=60
# Rate limit for one-time WS ticket issuance per minute.
WS_TICKET_RATE_LIMIT_PER_MINUTE=30
# Timeout (ms) for the relay's session/ticket verification calls to the API.
WS_RELAY_AUTH_TIMEOUT_MS=10000
# Glitchtip/Sentry DSN for the ws-relay process (falls back to GLITCHTIP_DSN).
WS_RELAY_GLITCHTIP_DSN=

# ──────────────────────────────────────────────────────────
# 16. INTERNAL SECRETS & RUNTIME TUNING (documented, consumed in src)
# ──────────────────────────────────────────────────────────
# Secrets used to authenticate inbound webhooks and internal service calls.
# Generate with: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=
INTERNAL_API_SECRET=

# Gate outbound email sending (default: disabled unless set to "true").
EMAIL_ENABLED=false

# Override plan resolution for a given account id (debug/testing only).
PLAN_OVERRIDE=

# Trust upstream X-Forwarded-* headers (set "true" behind a trusted proxy).
TRUST_PROXY=false

# Public storage endpoint used when building externally-resolvable asset URLs.
STORAGE_PUBLIC_ENDPOINT=

# ── Backups ─────────────────────────────────────────────────────
# Interval between pg_dump runs (seconds). 86400 = daily, 3600 = hourly.
BACKUP_INTERVAL_SECONDS=86400
# Days to retain compressed dumps in ./backups
BACKUP_RETENTION_DAYS=14
# Optional offsite copy (needs `aws` CLI on host cron; sidecar skips if absent).
# BACKUP_S3_TARGET=s3://beaver-backups/pg
# BACKUP_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ── Horizontal scaling ──────────────────────────────────────────
# When set, API rate limiting is shared across replicas via Redis.
# Required when running `docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.scale.yml up -d`
REDIS_URL=redis://redis:6379

# Per-route rate limits (requests per minute) and body limits.
VAULT_RATE_LIMIT_PER_MINUTE=60
ASSET_BATCH_DOWNLOAD_RATE_LIMIT_PER_MINUTE=30
COMMENTS_RATE_LIMIT_PER_MINUTE=60
COMMENTS_BODY_LIMIT_BYTES=4096
YJS_SYNC_BODY_LIMIT_BYTES=10485760
YJS_SYNC_READ_RATE_LIMIT=120
YJS_SYNC_WRITE_RATE_LIMIT=60

# Port the standalone WebSocket relay listens on (compose maps/Caddy expects 8080).
WS_RELAY_PORT=8080

# ── Misc runtime (all have code defaults; shown values are those defaults) ──
# Deep-link scheme used when building workspace/note invite URLs.
INVITE_URL_SCHEME=beaver-notes://
# Rate limit for batch asset seed/download endpoints per minute.
SEED_BATCH_RATE_LIMIT_PER_MINUTE=30
# TTL (seconds) of one-time SSO authorization-code exchanges.
SSO_EXCHANGE_TTL_SECONDS=60
# Body size limit for vault routes.
VAULT_BODY_LIMIT_BYTES=65536

# ──────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST
# ──────────────────────────────────────────────────────────
# When deploying the API that the Beaver Notes client connects to:
#
#  1. WEBAUTHN_RPID — must match the HTTPS API host (e.g. api.beavernotes.com)
#  2. WEBAUTHN_ORIGIN — must be https://api.beavernotes.com
#  3. LEGACY_AUTH_ENABLED — set to false for passkeys only
#  4. MLKEM_SEED — generate once with openssl rand -hex 64, persist as secret
#  5. ALLOWED_ORIGINS — must include the API origin and any client origins
#  6. STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — set for payment processing
#  7. APPLE_KEY_ID / APPLE_ISSUER_ID / APPLE_P8_KEY_PATH — set for iOS IAP
#  8. GOOGLE_SERVICE_ACCOUNT_KEY_PATH — set for Android IAP
