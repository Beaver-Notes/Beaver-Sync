# Beaver Sync — environment template.
#   cp .env.example .env
# Every variable below without a value has a working default or disables an
# optional feature. Variables absent from this file are read by src/ with a
# code default — see TUNING at the bottom before adding one back.

# ── Core ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# ── Postgres (consumed by docker-compose) ─────────────
DATABASE_URL=postgresql://beaver:beaver@localhost:5432/beaver
POSTGRES_USER=beaver
POSTGRES_PASSWORD=beaver
POSTGRES_DB=beaver
POSTGRES_PORT=5432
DATABASE_POOL_MAX=10

# ── Secrets (openssl rand -hex 32) ────────────────────
# Required in production; dev only warns. Sessions, tokens, and note history
# are keyed by these, so rotating one invalidates what it protects.
COOKIE_SECRET=
SESSION_HMAC_KEY=
EMAIL_HMAC_KEY=
NOTE_HMAC_KEY=
INTERNAL_API_SECRET=
INBOUND_WEBHOOK_SECRET=
# Recomputes share-link tokens after a restart; rotating invalidates links.
LINK_TOKEN_SECRET=
# Master key for encrypted metadata. Lose it and the data is unrecoverable.
# openssl rand -hex 64
MLKEM_SEED=

# ── Auth ──────────────────────────────────────────────
# Unset counts as enabled (password reset, verification, TOTP).
LEGACY_AUTH_ENABLED=true
# RP ID must be the registrable domain of WEBAUTHN_ORIGIN; the ceremony
# origin is compared by equality, so only one web origin is supported.
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Beaver Sync
REFRESH_TOKEN_TTL_DAYS=30
IDLE_TIMEOUT_HOURS=24
PLAN_OVERRIDE=

# ── Storage ───────────────────────────────────────────
# seaweedfs (local dev) or cloudflare-r2. STORAGE_* win; SEAWEEDFS_* are the
# dev fallbacks and R2_* aliases are accepted for the R2 pair.
STORAGE_BACKEND=seaweedfs
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_NAME=beaver-sync
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL for asset links; empty means presigned URLs only.
STORAGE_PUBLIC_ENDPOINT=
SEAWEEDFS_ENDPOINT=
SEAWEEDFS_BUCKET_NAME=
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
# LAN address used when building presigned URLs for other devices.
LAN_IP=localhost

# ── Email ─────────────────────────────────────────────
# Sending is attempted unless this is exactly "false".
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@beavernotes.com
NOTIFY_DOMAIN=
# Inbound alias forwarding.
FORWARD_TYPE=
FORWARD_SMTP_HOST=
FORWARD_SMTP_PORT=587
FORWARD_SMTP_USER=
FORWARD_SMTP_PASS=
FORWARD_FROM_ADDRESS=

# ── Payments: Stripe ──────────────────────────────────
# One variable per sellable plan and interval; empty means not for sale.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# ── Payments: stores ──────────────────────────────────
# Verified against Apple's cert chain and Google's Pub/Sub OIDC token, so no
# key files are needed. A product id matching no tier grants no plan.
APPLE_BUNDLE_ID=
APPLE_PRODUCT_STARTER=
APPLE_PRODUCT_PRO=
APPLE_PRODUCT_TEAM=
GOOGLE_PRODUCT_STARTER=
GOOGLE_PRODUCT_PRO=
GOOGLE_PRODUCT_TEAM=

# ── Enterprise license ────────────────────────────────
# Production requires a LICENSE_KEY signed with LICENSE_SECRET:
#   LICENSE_SECRET=$(openssl rand -hex 32) node scripts/generate-license.js \
#     --licensee "Acme" --expiry 2027-08-30 --seats 50
ENTERPRISE_MODE=false
LICENSE_SECRET=
LICENSE_KEY=

# ── Realtime ──────────────────────────────────────────
AUTH_BACKEND_URL=http://localhost:3000
WS_RELAY_PORT=8080
WS_RELAY_AUTH_TIMEOUT_MS=10000
# Redis shares rate-limit state across replicas. Required only with
# docker-compose.scale.yml.
REDIS_URL=redis://localhost:6379

# ── URLs and limits ───────────────────────────────────
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL_BASE=
VERIFY_EMAIL_URL_BASE=
INVITE_URL_SCHEME=beaver-notes://
SSO_EXCHANGE_TTL_SECONDS=60
FASTIFY_MAX_PARAM_LENGTH=200

# ── Monitoring ────────────────────────────────────────
GLITCHTIP_DSN=
WS_RELAY_GLITCHTIP_DSN=

# ── Backups (pg-backup sidecar) ───────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# BACKUP_S3_TARGET=s3://bucket/pg
# BACKUP_S3_ENDPOINT=

# ── TUNING ────────────────────────────────────────────
# Every other variable is read by src/ with a code default: rate limits, body
# limits, timeouts, GC intervals, cursor caps. Set one only when the default is
# wrong for you; do not mirror defaults here. To list the names:
#   grep -rhoE 'process\.env\.[A-Z0-9_]+' src | sort -u
