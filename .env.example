# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
COOKIE_SECRET=change-me-cookie-secret

# Session, email, and note HMAC keys (min 32 chars each)
SESSION_HMAC_KEY=change-me-session-hmac-key-min-32-chars
EMAIL_HMAC_KEY=change-me-email-hmac-key-min-32-chars
NOTE_HMAC_KEY=change-me-note-hmac-key-min-32-chars

# Legacy JWT (only required when LEGACY_AUTH_ENABLED=true)
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_EXPIRES_IN=30d

LEGACY_AUTH_ENABLED=true

# SQLite database path
DATABASE_PATH=/app/data/beaver.db

# Storage
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=beaver-sync
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=beaver-sync
MINIO_ENDPOINT=http://minio:9000

R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=http://localhost:3000
LEMONSQUEEZY_WEBHOOK_SECRET=replace-me

# Self-hosted Glitchtip (Sentry-compatible error monitoring)
# Deploy on Fly.io from the official Docker image.
# If unset, error monitoring is disabled.
GLITCHTIP_DSN=

# Transactional email via Resend (optional - no-op if not set)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@beavernotes.com

WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Beaver Sync

# ─────────────────────────────────────────────────────────────────────────────
# Production checklist (Beaver Notes v5 client)
# ─────────────────────────────────────────────────────────────────────────────
# When deploying the production API that the Beaver Notes v5 client connects
# to, set the following:
#
#   1. WEBAUTHN_RPID must match the API host the client talks to
#      (e.g. api.beavernotes.com). The client constructs the WebAuthn ceremony
#      against the API origin, not the app's own origin.
#
#   2. WEBAUTHN_ORIGIN must be the public URL of the API, e.g.
#      https://api.beavernotes.com. Both must be HTTPS in production.
#
#   3. LEGACY_AUTH_ENABLED=true keeps the bcrypt+JWT password path active
#      alongside passkeys. The Beaver Notes v5 client supports both. When
#      all users have migrated, set this to false and remove the
#      JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH variables.
#
#   4. MLKEM_SEED must be 64 bytes (128 hex chars). Generate once and persist:
#        openssl rand -hex 64
#      Then:  fly secrets set MLKEM_SEED=<hex>
#      Rotating this seed re-wraps all existing encrypted blobs on next read.
#
#   5. ALLOWED_ORIGINS must include the API origin. CORS rejects requests
#      that are not on the allowlist.
# ─────────────────────────────────────────────────────────────────────────────

# ML-KEM post-quantum encryption seed (64 bytes hex)
# Generated automatically on first boot if not set.
# For production (Fly.io): fly secrets set MLKEM_SEED=$(openssl rand -hex 64)
MLKEM_SEED=
MLKEM_SEED_PATH=./keys/mlkem-seed.hex
